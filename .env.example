# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.development
# 2. Replace placeholder values with your credentials
# 3. Also create a .env holding just DATABASE_URL - the Prisma CLI
#    (prisma studio / migrate / seed) reads .env, not .env.development
# 4. NEVER commit .env, .env.development or .env.production
#
# ⚠️  SECURITY: All credential files are gitignored
# ============================================

# Database Configuration
DATABASE_URL=postgresql://velocity_user:CHANGE_PASSWORD@localhost:5433/velocity_db

# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# JWT Configuration
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_SECURE_RANDOM_STRING_HERE
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Argon2 Password Hashing (BSI Recommended)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Stripe Configuration
# Get test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE

# Email Configuration (SMTP)
# Sign up: https://resend.com/signup (100 emails/day free)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY_HERE
SMTP_FROM=noreply@yourdomain.com

# ============================================
# QUICK START:
# ============================================
# 1. Create accounts:
#    - Stripe (test mode): https://dashboard.stripe.com/register
#    - Resend: https://resend.com/signup
#
# 2. Start development:
#    docker-compose up -d
#    nx run shared-data-access:db-migrate
#    nx run shared-data-access:db-seed
#    nx serve backend
#    nx serve frontend
# ============================================
